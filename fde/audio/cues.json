  {
   "id": "P4",
   "title": "押注：两大巨头，同一天下场",
   "start": 91.666,
   "dur": 71.026,
   "cues": [
    {
     "t": 91.666,
     "s": "二零二六年五月四日，",
     "e": 93.778
    },
    {
     "t": 93.958,
     "s": "两大巨头在同一天，",
     "e": 95.878
    },
    {
     "t": 96.058,
     "s": "押注了同一件事：",
