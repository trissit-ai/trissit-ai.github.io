  {
   "id": "P4",
   "title": "押注：两大巨头，同一天下场",
   "start": 71.428,
   "dur": 60.954,
   "cues": [
    {
     "t": 71.428,
     "s": "二零二六年五月四日，",
     "e": 72.808
    },
    {
     "t": 72.853,
     "s": "两大巨头在同一天，",
     "e": 74.227
    },
    {
     "t": 74.272,
     "s": "押注了同一件事：",
     "e": 75.505
    },
    {
     "t": 75.55,
     "s": "帮 AI 进入企业。",
     "e": 77.521
    },
    {
     "t": 77.821,
     "s": "OpenAI 成立 The Deployment Company，",
     "e": 79.989
    },
    {
     "t": 80.034,
     "s": "TPG、贝恩、Brookfield、高盛等 十九家 机构入局，",
     "e": 84.691
    },
    {
     "t": 84.736,
     "s": "募资 四十亿 美元，",
     "e": 86.949
    },
    {
     "t": 86.994,
     "s": "估值 一百亿 美元；",
     "e": 89.116
    },
    {
     "t": 89.161,
     "s": "五月十一日再收购 Tomoro，",
     "e": 91.303
    },
    {
     "t": 91.348,
     "s": "一次引入约 一百五十名 FDE 工程师。",
     "e": 94.609
    },
    {
     "t": 94.654,
     "s": "OpenAI 的首席运营官说得很直白：",
     "e": 97.128
    },
    {
     "t": 97.173,
     "s": "\"客户需要帮助，从概念验证走向大规模落地。",
     "e": 100.713
    },
    {
     "t": 100.808,
     "s": "同一天，Anthropic 联合黑石、Hellman & Friedman 与高盛，",
     "e": 105.192
    },
    {
     "t": 105.237,
     "s": "成立总规模 十五亿 美元的企业 AI 合资公司。",
     "e": 109.821
    },
    {
     "t": 109.866,
     "s": "高盛资管的判断同样直接：",
     "e": 111.99
    },
    {
     "t": 112.035,
     "s": "\"拥有模型本身，不会改变你的工作流程或运营方式。",
     "e": 115.942
    },
    {
     "t": 116.037,
     "s": "这套打法并不新：",
     "e": 117.327
    },
    {
     "t": 117.372,
     "s": "它源自 Palantir 为情报与国防部门做数据分析时发明的驻场模式。",
     "e": 122.29
    },
    {
     "t": 122.335,
     "s": "二零二五年一到九月，",
     "e": 123.779
    },
    {
     "t": 123.824,
     "s": "FDE 岗位的招聘量暴涨超过 百分之八百。",
     "e": 127.202
    },
    {
     "t": 127.247,
     "s": "工程师正像洪水一样涌进企业，",
     "e": 129.651
    },
    {
     "t": 129.696,
     "s": "把 AI 冲进真实业务。",
     "e": 131.887
    }
   ]
  },
  {
   "id": "P5",
   "title": "破局：用 FDE 的两种最有效的解法，去构建 Flux 一座桥",
   "start": 132.382,
   "dur": 39.841,
   "cues": [
    {
     "t": 132.382,
     "s": "我们用 FDE 的方法，",
     "e": 133.792
    },
    {
     "t": 133.837,
     "s": "构建业务 AI 转型的计划，",
     "e": 136.265
    },
    {
     "t": 136.31,
     "s": "命名为 Flux。",
     "e": 137.594
    },
    {
     "t": 137.894,
     "s": "那么 Flux 怎么落地？",
     "e": 139.48
    },
    {
     "t": 139.525,
     "s": "两件事，",
     "e": 140.29
    },
    {
     "t": 140.335,
     "s": "一座桥。",
     "e": 141.205
    },
    {
     "t": 141.505,
     "s": "第一，",
     "e": 142.032
    },
    {
     "t": 142.077,
     "s": "定制出合用的 AI 工具。",
     "e": 144.296
    },
    {
     "t": 144.341,
     "s": "不是采购现成产品，",
     "e": 145.765
    },
    {
     "t": 145.81,
     "s": "而是像研发\"配方\"一样，",
     "e": 147.191
    },
    {
     "t": 147.236,
     "s": "贴着业务定制工作流。",
     "e": 148.772
    },
    {
     "t": 148.817,
     "s": "没有合用的工具，",
     "e": 149.89
    },
    {
     "t": 149.935,
     "s": "推行就是强按头。",
     "e": 151.263
    },
    {
     "t": 151.563,
     "s": "第二，",
     "e": 152.141
    },
    {
     "t": 152.186,
     "s": "推行全员使用。",
     "e": 153.521
    },
    {
     "t": 153.566,
     "s": "不是发个账号就完事，",
     "e": 154.929
    },
    {
     "t": 154.974,
     "s": "而是排除\"不能用\"和\"不好用\"的障碍，",
     "e": 156.986
    },
    {
     "t": 157.031,
     "s": "教会每一个人，",
     "e": 158.014
    },
    {
     "t": 158.059,
     "s": "用数据度量产出。",
     "e": 159.508
    },
    {
     "t": 159.553,
     "s": "没有全员使用，",
     "e": 160.653
    },
    {
     "t": 160.698,
     "s": "工具就是摆设。",
     "e": 161.808
    },
    {
     "t": 162.108,
     "s": "而连接这两件事的桥，",
     "e": 163.665
    },
    {
     "t": 163.71,
     "s": "就是 Flux：",
     "e": 165.04
    },
    {
     "t": 165.085,
     "s": "一边贴着 懂业务的人，",
     "e": 167.01
    },
    {
     "t": 167.055,
     "s": "一边接着 AI 的工具与能力。",
     "e": 169.679
    },
    {
     "t": 169.724,
     "s": "让每一项业务，",
     "e": 170.644
    },
    {
     "t": 170.689,
     "s": "都能稳定出品。",
     "e": 171.728
    }
   ]
  },
