    },
    {
     "t": 97.99,
     "s": "帮 AI 进入企业。",
     "e": 99.886
    },
    {
     "t": 100.326,
     "s": "OpenAI 成立 The Deployment Company，",
     "e": 102.942
    },
    {
     "t": 103.122,
     "s": "TPG、贝恩、Brookfield、高盛等 十九家 机构入局，",
     "e": 107.85
    },
    {
     "t": 108.03,
     "s": "募资 四十亿 美元，",
     "e": 110.622
    },
    {
     "t": 110.802,
     "s": "估值 一百亿 美元；",
     "e": 113.322
    },
    {
     "t": 113.502,
     "s": "五月十一日再收购 Tomoro，",
     "e": 116.07
    },
    {
     "t": 116.25,
     "s": "一次引入约 一百五十名 FDE 工程师。",
     "e": 120.162
    },
    {
     "t": 120.342,
     "s": "OpenAI 的首席运营官说得很直白：",
     "e": 123.198
    },
    {
     "t": 123.378,
     "s": "\"客户需要帮助，从概念验证走向大规模落地。",
     "e": 127.146
    },
    {
     "t": 127.246,
     "s": "同一天，Anthropic 联合黑石、Hellman & Friedman 与高盛，",
     "e": 131.758
    },
    {
     "t": 131.938,
     "s": "成立总规模 十五亿 美元的企业 AI 合资公司。",
     "e": 136.162
    },
    {
     "t": 136.342,
     "s": "高盛资管的判断同样直接：",
     "e": 138.886
    },
    {
     "t": 139.066,
     "s": "\"拥有模型本身，不会改变你的工作流程或运营方式。",
     "e": 143.17
    },
    {
     "t": 143.27,
     "s": "这套打法并不新：",
     "e": 145.07
    },
    {
     "t": 145.25,
     "s": "它源自 Palantir 为情报与国防部门做数据分析时发明的驻场模式。",
     "e": 150.218
    },
    {
     "t": 150.398,
     "s": "二零二五年一到九月，",
     "e": 152.51
    },
    {
     "t": 152.69,
     "s": "FDE 岗位的招聘量暴涨超过 百分之八百。",
     "e": 157.01
    },
    {
     "t": 157.19,
     "s": "工程师正像洪水一样涌进企业，",
     "e": 159.95
    },
    {
     "t": 160.13,
     "s": "把 AI 冲进真实业务。",
     "e": 162.242
    }
   ]
  },
  {
   "id": "P5",
   "title": "破局：用 FDE 的两种最有效的解法，去构建 Flux 一座桥",
   "start": 162.692,
   "dur": 49.338,
   "cues": [
    {
     "t": 162.692,
     "s": "那么 Flux 怎么落地？",
     "e": 164.756
    },
    {
     "t": 164.936,
     "s": "两件事，",
     "e": 166.304
    },
    {
     "t": 166.484,
     "s": "一座桥。",
     "e": 167.924
    },
    {
     "t": 168.364,
     "s": "第一，",
     "e": 169.492
    },
    {
     "t": 169.672,
     "s": "定制出合用的 AI 工具。",
     "e": 172.096
    },
    {
     "t": 172.276,
     "s": "不是采购现成产品，",
     "e": 174.22
    },
    {
     "t": 174.4,
     "s": "而是像研发\"配方\"一样，",
     "e": 176.32
    },
    {
     "t": 176.5,
     "s": "贴着业务定制工作流。",
     "e": 178.588
    },
    {
     "t": 178.768,
     "s": "没有合用的工具，",
     "e": 180.4
    },
    {
     "t": 180.58,
     "s": "推行就是强按头。",
     "e": 182.428
    },
    {
     "t": 182.868,
     "s": "第二，",
     "e": 184.068
    },
    {
     "t": 184.248,
     "s": "推行全员使用。",
     "e": 186.096
    },
    {
     "t": 186.276,
     "s": "不是发个账号就完事，",
     "e": 188.172
    },
    {
     "t": 188.352,
     "s": "而是排除\"不能用\"和\"不好用\"的障碍，",
     "e": 190.824
    },
    {
     "t": 191.004,
     "s": "教会每一个人，",
     "e": 192.588
    },
    {
     "t": 192.768,
     "s": "用数据度量产出。",
     "e": 194.712
    },
    {
     "t": 194.892,
     "s": "没有全员使用，",
     "e": 196.548
    },
    {
     "t": 196.728,
     "s": "工具就是摆设。",
     "e": 198.384
    },
    {
     "t": 198.824,
     "s": "而连接这两件事的桥，",
     "e": 200.888
    },
    {
     "t": 201.068,
     "s": "就是 Flux：",
     "e": 202.892
    },
    {
     "t": 203.072,
     "s": "一边贴着 懂业务的人，",
     "e": 205.448
    },
    {
     "t": 205.628,
     "s": "一边接着 AI 的工具与能力。",
     "e": 208.028
    },
    {
     "t": 208.208,
     "s": "让每一项业务，",
     "e": 209.768
    },
    {
     "t": 209.948,
     "s": "都能稳定出品。",
     "e": 211.58
    }
   ]
  },
  {
