     "e": 258.842
    },
    {
     "t": 259.022,
     "s": "驻场拿下真实业务场景，",
     "e": 261.614
    },
    {
     "t": 261.794,
     "s": "让 AI 在业务里赢下结果。",
     "e": 264.866
    },
    {
     "t": 265.306,
     "s": "Create、Build、Win。",
     "e": 267.922
    },
    {
     "t": 268.102,
