  {
   "id": "P5",
   "title": "破局：用 FDE 的两种最有效的解法，去构建 Flux 一座桥",
   "start": 180.26,
   "dur": 55.314,
   "cues": [
    {
     "t": 180.26,
     "s": "那么 Flux 怎么落地？",
     "e": 182.612
    },
    {
     "t": 182.792,
     "s": "两件事，",
     "e": 184.328
    },
    {
     "t": 184.508,
     "s": "一座桥。",
     "e": 186.14
    },
    {
     "t": 186.58,
     "s": "第一，",
     "e": 187.876
    },
    {
     "t": 188.056,
     "s": "定制出合用的 AI 工具。",
     "e": 190.816
    },
    {
     "t": 190.996,
     "s": "不是采购现成产品，",
     "e": 193.204
    },
    {
     "t": 193.384,
     "s": "而是像研发\"配方\"一样，",
     "e": 195.568
    },
    {
     "t": 195.748,
     "s": "贴着业务定制工作流。",
     "e": 198.124
    },
    {
     "t": 198.304,
     "s": "没有合用的工具，",
     "e": 200.152
    },
    {
     "t": 200.332,
     "s": "推行就是强按头。",
     "e": 202.444
    },
    {
     "t": 202.884,
     "s": "第二，",
     "e": 204.252
    },
    {
     "t": 204.432,
     "s": "推行全员使用。",
     "e": 206.52
    },
    {
     "t": 206.7,
     "s": "不是发个账号就完事，",
     "e": 208.836
    },
    {
     "t": 209.016,
     "s": "而是排除\"不能用\"和\"不好用\"的障碍，",
     "e": 211.824
    },
    {
     "t": 212.004,
     "s": "教会每一个人，",
     "e": 213.804
    },
    {
     "t": 213.984,
     "s": "用数据度量产出。",
     "e": 216.192
    },
    {
     "t": 216.372,
     "s": "没有全员使用，",
     "e": 218.244
    },
    {
     "t": 218.424,
     "s": "工具就是摆设。",
     "e": 220.296
    },
    {
     "t": 220.736,
     "s": "而连接这两件事的桥，",
     "e": 223.088
    },
    {
     "t": 223.268,
     "s": "就是 Flux：",
     "e": 225.356
    },
    {
     "t": 225.536,
     "s": "一边贴着 懂业务的人，",
     "e": 228.224
    },
    {
     "t": 228.404,
     "s": "一边接着 AI 的工具与能力。",
     "e": 231.14
    },
    {
     "t": 231.32,
     "s": "让每一项业务，",
     "e": 233.096
    },
    {
     "t": 233.276,
     "s": "都能稳定出品。",
     "e": 235.124
    }
   ]
  },
