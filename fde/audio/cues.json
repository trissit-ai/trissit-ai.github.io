    },
    {
     "t": 233.774,
     "s": "驻场拿下真实业务场景，",
     "e": 236.054
    },
    {
     "t": 236.234,
     "s": "让 AI 在业务里赢下结果。",
     "e": 238.922
    },
    {
     "t": 239.362,
     "s": "Create、Build、Win。",
     "e": 241.666
    },
    {
     "t": 241.846,
