    },
    {
     "t": 176.426,
     "s": "把 AI 冲进真实业务。",
     "e": 178.809
    }
   ]
  },
  {
   "id": "P5",
   "title": "破局：用 FDE 的两种最有效的解法，去构建 Flux 一座桥",
   "start": 179.259,
   "dur": 54.89,
   "cues": [
    {
     "t": 179.259,
     "s": "那么 Flux 怎么落地？",
     "e": 181.588
    },
    {
     "t": 181.768,
     "s": "两件事，",
     "e": 183.301
    },
    {
     "t": 183.481,
     "s": "一座桥。",
     "e": 185.096
    },
    {
     "t": 185.536,
     "s": "第一，",
     "e": 186.798
    },
    {
     "t": 186.978,
     "s": "定制出合用的 AI 工具。",
     "e": 189.717
    },
    {
     "t": 189.897,
     "s": "不是采购现成产品，",
     "e": 192.087
    },
    {
     "t": 192.267,
     "s": "而是像研发\"配方\"一样，",
     "e": 194.431
    },
    {
     "t": 194.611,
     "s": "贴着业务定制工作流。",
     "e": 196.967
    },
    {
     "t": 197.147,
     "s": "没有合用的工具，",
     "e": 198.981
    },
    {
     "t": 199.161,
     "s": "推行就是强按头。",
     "e": 201.242
    },
    {
     "t": 201.682,
     "s": "第二，",
     "e": 203.024
    },
    {
     "t": 203.204,
     "s": "推行全员使用。",
     "e": 205.285
    },
    {
     "t": 205.465,
     "s": "不是发个账号就完事，",
     "e": 207.602
    },
    {
     "t": 207.782,
     "s": "而是排除\"不能用\"和\"不好用\"的障碍，",
     "e": 210.574
    },
    {
     "t": 210.754,
     "s": "教会每一个人，",
     "e": 212.535
    },
    {
     "t": 212.715,
     "s": "用数据度量产出。",
     "e": 214.906
    },
    {
     "t": 215.086,
     "s": "没有全员使用，",
     "e": 216.949
    },
    {
     "t": 217.129,
     "s": "工具就是摆设。",
     "e": 218.992
    },
    {
     "t": 219.432,
     "s": "而连接这两件事的桥，",
     "e": 221.761
    },
    {
     "t": 221.941,
     "s": "就是 Flux：",
     "e": 223.996
    },
    {
     "t": 224.176,
     "s": "一边贴着 懂业务的人，",
     "e": 226.859
    },
    {
     "t": 227.039,
     "s": "一边接着 AI 的工具与能力。",
     "e": 229.751
    },
    {
     "t": 229.931,
     "s": "让每一项业务，",
     "e": 231.685
    },
    {
     "t": 231.865,
     "s": "都能稳定出品。",
     "e": 233.699
    }
   ]
  },
