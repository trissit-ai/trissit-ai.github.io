    },
    {
     "t": 107.73,
     "s": "帮 AI 进入企业。",
     "e": 109.867
    },
    {
     "t": 110.307,
     "s": "OpenAI 成立 The Deployment Company，",
     "e": 113.264
    },
    {
     "t": 113.444,
     "s": "TPG、贝恩、Brookfield、高盛等 十九家 机构入局，",
     "e": 118.81
