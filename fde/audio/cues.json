  {
   "id": "P4",
   "title": "押注：两大巨头，同一天下场",
   "start": 100.671,
   "dur": 78.587,
   "cues": [
    {
     "t": 100.671,
     "s": "二零二六年五月四日，",
     "e": 103.054
    },
    {
     "t": 103.234,
     "s": "两大巨头在同一天，",
     "e": 105.398
    },
    {
