  {
   "id": "P4",
   "title": "押注：两大巨头，同一天下场",
   "start": 96.398,
   "dur": 74.114,
   "cues": [
    {
     "t": 96.398,
     "s": "二零二六年五月四日，",
     "e": 98.606
    },
    {
     "t": 98.866,
     "s": "两大巨头在同一天，",
     "e": 101.098
    },
    {
     "t": 101.358,
     "s": "押注了同一件事：",
     "e": 103.398
    },
    {
     "t": 103.658,
     "s": "帮 AI 进入企业。",
     "e": 105.602
    },
    {
     "t": 106.222,
     "s": "OpenAI 成立 The Deployment Company，",
     "e": 108.526
    },
    {
     "t": 108.786,
     "s": "TPG、贝恩、Brookfield、高盛等 十九家 机构入局，",
     "e": 113.586
    },
    {
     "t": 113.846,
     "s": "募资 四十亿 美元，",
     "e": 116.342
    },
    {
     "t": 116.602,
     "s": "估值 一百亿 美元；",
     "e": 119.074
    },
    {
     "t": 119.334,
     "s": "五月十一日再收购 Tomoro，",
     "e": 121.902
    },
    {
     "t": 122.162,
     "s": "一次引入约 一百五十名 FDE 工程师。",
     "e": 125.522
    },
    {
     "t": 125.782,
     "s": "OpenAI 的首席运营官说得很直白：",
     "e": 128.806
    },
    {
     "t": 129.066,
     "s": "\"客户需要帮助，从概念验证走向大规模落地。",
     "e": 133.314
    },
    {
     "t": 133.454,
     "s": "同一天，Anthropic 联合黑石、Hellman & Friedman 与高盛，",
     "e": 137.774
    },
    {
     "t": 138.034,
     "s": "成立总规模 十五亿 美元的企业 AI 合资公司。",
     "e": 142.258
    },
    {
     "t": 142.518,
     "s": "高盛资管的判断同样直接：",
     "e": 145.326
    },
    {
     "t": 145.586,
     "s": "\"拥有模型本身，不会改变你的工作流程或运营方式。",
     "e": 150.002
    },
    {
     "t": 150.142,
     "s": "这套打法并不新：",
     "e": 152.11
    },
    {
     "t": 152.37,
     "s": "它源自 Palantir 为情报与国防部门做数据分析时发明的驻场模式。",
     "e": 157.53
    },
    {
     "t": 157.79,
     "s": "二零二五年一到九月，",
     "e": 159.974
    },
    {
     "t": 160.234,
     "s": "FDE 岗位的招聘量暴涨超过 百分之八百。",
     "e": 164.074
    },
    {
     "t": 164.334,
     "s": "工程师正像洪水一样涌进企业，",
     "e": 167.382
    },
    {
     "t": 167.642,
     "s": "把 AI 冲进真实业务。",
     "e": 169.922
    }
   ]
  },
  {
   "id": "P5",
   "title": "破局：用 FED 的两种最有效的解法，去构建 Flux 一座桥",
   "start": 170.512,
   "dur": 55.65,
   "cues": [
    {
     "t": 170.512,
     "s": "那么 Flux 怎么落地？",
     "e": 172.744
    },
    {
     "t": 173.004,
     "s": "两件事，",
     "e": 174.468
    },
    {
     "t": 174.728,
     "s": "一座桥。",
     "e": 176.12
    },
    {
     "t": 176.74,
     "s": "第一，",
     "e": 177.964
    },
    {
     "t": 178.224,
     "s": "定制出合用的 AI 工具。",
     "e": 180.624
    },
    {
     "t": 180.884,
     "s": "不是采购现成产品，",
     "e": 183.092
    },
    {
     "t": 183.352,
     "s": "而是像研发\"配方\"一样，",
     "e": 185.632
    },
    {
     "t": 185.892,
     "s": "贴着业务定制工作流。",
     "e": 188.076
    },
    {
     "t": 188.336,
     "s": "没有合用的工具，",
     "e": 190.256
    },
    {
     "t": 190.516,
     "s": "推行就是强按头。",
     "e": 192.532
    },
    {
     "t": 193.152,
     "s": "第二，",
     "e": 194.4
    },
    {
     "t": 194.66,
     "s": "推行全员使用。",
     "e": 196.628
    },
    {
     "t": 196.888,
     "s": "不是发个账号就完事，",
     "e": 199.024
    },
    {
     "t": 199.284,
     "s": "而是排除\"不能用\"和\"不好用\"的障碍，",
     "e": 202.164
    },
    {
     "t": 202.424,
     "s": "教会每一个人，",
     "e": 204.344
    },
    {
     "t": 204.604,
     "s": "用数据度量产出。",
     "e": 206.668
    },
    {
     "t": 206.928,
     "s": "没有全员使用，",
     "e": 208.8
    },
    {
     "t": 209.06,
     "s": "工具就是摆设。",
     "e": 210.884
    },
    {
     "t": 211.504,
     "s": "而连接这两件事的桥，",
     "e": 213.784
    },
    {
     "t": 214.044,
     "s": "就是 Flux：",
     "e": 215.796
    },
    {
     "t": 216.056,
     "s": "一边贴着 懂业务的人，",
     "e": 218.648
    },
    {
     "t": 218.908,
     "s": "一边接着 AI 的工具与能力。",
     "e": 221.404
    },
    {
     "t": 221.664,
     "s": "让每一项业务，",
     "e": 223.44
    },
    {
     "t": 223.7,
     "s": "都能稳定出品。",
     "e": 225.572
    }
   ]
  },
